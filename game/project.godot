; The Forger: Retro Tycoon — szkielet projektu Godot 4
; Zobacz docs/GDD.md w repo głównym po pełny projekt gry.

config_version=5

[application]

config/name="The Forger: Retro Tycoon"
config/description="Ekonomiczna gra strategiczna inspirowana grą Vermeer (Ariolasoft, 1987)."
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://art/icons/app_icon.jpg"

[autoload]

SceneRouter="*res://scripts/autoload/SceneRouter.gd"
Calendar="*res://scripts/autoload/Calendar.gd"
Cities="*res://scripts/autoload/Cities.gd"
Travel="*res://scripts/autoload/Travel.gd"
Crops="*res://scripts/autoload/Crops.gd"
Economy="*res://scripts/autoload/Economy.gd"
PlayerPlantations="*res://scripts/autoload/PlayerPlantations.gd"
Paintings="*res://scripts/autoload/Paintings.gd"
Auctions="*res://scripts/autoload/Auctions.gd"
ShippingCompanies="*res://scripts/autoload/ShippingCompanies.gd"
ForwardContracts="*res://scripts/autoload/ForwardContracts.gd"
YearlyReport="*res://scripts/autoload/YearlyReport.gd"
WorldEvents="*res://scripts/autoload/WorldEvents.gd"
AIPlayers="*res://scripts/autoload/AIPlayers.gd"
Security="*res://scripts/autoload/Security.gd"
Players="*res://scripts/autoload/Players.gd"
GameState="*res://scripts/autoload/GameState.gd"
SaveGame="*res://scripts/autoload/SaveGame.gd"
Localization="*res://scripts/autoload/Localization.gd"
Music="*res://scripts/autoload/Music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/translations=PackedStringArray("res://translations/ui.en.translation", "res://translations/ui.de.translation")
locale/fallback="pl"
